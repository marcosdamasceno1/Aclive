# Copie para .env e preencha. NUNCA versione o .env real.

# Chave de API do WAHA — gere uma forte, ex: openssl rand -hex 32
# É a mesma que vai no secret WAHA_API_KEY da Edge Function wa-gateway.
WAHA_API_KEY=

# Acesso ao dashboard do WAHA (painel de diagnóstico do próprio WAHA).
WAHA_DASHBOARD_USER=admin
WAHA_DASHBOARD_PASS=troque-esta-senha
