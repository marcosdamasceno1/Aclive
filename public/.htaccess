Options -MultiViews
RewriteEngine On
RewriteBase /
RewriteRule ^index\.html$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.html [L]

# ── Cache ─────────────────────────────────────────────────────────────────
# index.html NUNCA pode ser cacheado: ele aponta para o bundle JS com hash.
# Se o navegador guardar um index.html velho, o usuário roda a versão antiga
# do sistema mesmo após o deploy (causa clássica de "bug que já foi corrigido
# mas continua acontecendo").
<IfModule mod_headers.c>
  <FilesMatch "^(index|404)\.html$">
    Header set Cache-Control "no-store, no-cache, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
  # Assets com hash no nome podem ser cacheados para sempre — o nome muda a
  # cada build, então nunca servem conteúdo velho.
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
